# Never commit real credentials. Rotate any credential that has been exposed.
AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=your-db;Uid=your-user;Pwd=ROTATE_ME;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"
# Alternatively use a complete SQLAlchemy mssql+pyodbc URL in DATABASE_URL.
JWT_SECRET_KEY="replace-with-at-least-32-random-characters"
ADMIN_USERNAME="admin"
# Generate with: python -c "from backend.security import hash_password; print(hash_password('change-me'))"
ADMIN_PASSCODE_HASH="replace-with-a-pwdlib-hash"
CORS_ORIGINS="http://localhost:5173"
CREATE_TABLES_ON_STARTUP="false"
